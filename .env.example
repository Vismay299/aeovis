# Copy this file to .env.local and fill in the values

# Google Gemini (legacy; retained for deprecated helpers, not used by the
# unbranded prompt-gen / competitor-extraction path — see LLM_* below)
GEMINI_API_KEY=your_gemini_api_key_here

# Utility LLM (required for prompt generation + competitor extraction).
# Any OpenAI-compatible chat/completions endpoint works — set base URL, key
# and model to match your gateway. These names are provider-NEUTRAL on
# purpose: the deployed gateway has been OpenRouter and Xiaomi MiMo at
# different times, and a var named after one vendor while pointed at another
# is how nobody could tell which provider was actually answering (R5.1.1,
# findings C4/S19). Defaults to OpenRouter when LLM_BASE_URL is unset.
#
# The model id must be valid ON THIS GATEWAY — the same id is routinely
# invalid on another (see docs/vendors/mimo.md). Per-gateway request quirks
# are derived from LLM_BASE_URL in src/lib/llmConfig.js.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_llm_gateway_api_key_here
LLM_MODEL=google/gemma-4-31b-it:free
# DEPRECATED aliases, still read when the canonical name above is unset so an
# existing deployment does not break on deploy. They warn once per process and
# will be removed: OPENROUTER_BASE_URL, OPENROUTER_API_KEY, OPENROUTER_MODEL.
#
# Model prices, USD per 1,000,000 tokens, as JSON keyed by exact model id
# (R3.6.1, finding C4). A paid id that nothing can price is REFUSED before the
# request is sent — it throws UnpricedModelError and logs
# "[llm-price] UNPRICED MODEL" — because recording $0 for paid inference is how
# the content pipeline's CONTENT_MAX_COST_PER_ITEM cap became a cap that could
# never trip. Only OpenRouter echoes real spend; on MiMo or any other gateway
# every non-":free" id needs a rate here or in the built-in table
# (src/lib/llmPricing.js). A bare number means the same rate both ways. Look the
# rates up on the vendor's price page — the numbers below are SHAPE, not truth.
# LLM_MODEL_PRICES={"vendor/model-a":{"input":3,"output":15},"vendor/model-b":1}

# Per-call tool fees, USD per single invocation of a built-in provider tool,
# as JSON keyed by model id and then by tool name (R3.6.6). Some calls are
# billed twice — once per token and once per tool invocation (e.g. OpenAI's
# web_search at ~$0.01/call). A tool fee is a DIFFERENT unit from a token rate
# and lives in a separate table: mixing them is off by six orders of magnitude.
# IMPORTANT: setting OPENAI_MODEL requires entries in BOTH this table AND
# LLM_MODEL_PRICES, or the ChatGPT engine returns rows full of pricing errors.
# The built-in table (src/lib/llmPricing.js) only covers gpt-4o-mini's
# web_search fee. Look the fees up on the vendor's pricing page.
# LLM_TOOL_FEES={"gpt-4o-mini":{"web_search":0.01}}

# Cron/worker shared secret. REQUIRED in production: /api/scan/worker and
# /api/content/worker resume and create jobs that spend real vendor budget, and
# with this unset in NODE_ENV=production both routes now refuse every request
# (401) instead of running unauthenticated. Locally it may be left blank.
CRON_SECRET=a_long_random_string

# Operator perimeter (src/middleware.js). A shared token protects internal
# operator APIs. Customer `/api/customer/*` routes use Supabase Auth sessions
# plus brand membership and database RLS. The free-scan flow and cron workers
# have their own gates. Send this as `Authorization: Bearer <token>`,
# `x-operator-token: <token>`, or an `operator_token` cookie. In production,
# operator routes refuse requests when it is unset.
OPERATOR_TOKEN=another_long_random_string

# Probe-fleet ingest token (R1.2.4). The ONLY credential for
# POST /api/internal/probe-results, which writes the probe fleet's measurements
# into prompt_results. Send it as `Authorization: Bearer <token>` or
# `x-probe-ingest-token: <token>` -- there is no query-parameter carrier, because
# a token in a URL lands in access logs. Minimum 24 characters.
#
# UNLIKE CRON_SECRET THIS FAILS CLOSED EVERYWHERE, not only in production: with
# it unset the route answers 401 to every request, on a laptop as well as on
# Vercel. It has no dev caller to keep working -- the only client is the fleet in
# worker/, a separate deployment -- and it writes the table every score is
# computed from.
#
# Deliberately NOT the same value as CRON_SECRET: that one is held by Vercel cron
# and by the scan worker's self-continue fetch, and one credential for both the
# ingest route and two budget-spending endpoints cannot be rotated independently.
# The same value must also be set in the fleet's own environment.
PROBE_INGEST_TOKEN=a_third_long_random_string

# Free-scan rate limit (POST /api/scan). Fixed window, DB-backed
# (supabase/migrations/009). Defaults to 5 scans per hour per client address.
SCAN_RATE_LIMIT=5
SCAN_RATE_LIMIT_WINDOW_MS=3600000
# Per-deployment salt for the hashed client key. The rate-limit table is a
# counter, not a visitor log, so the raw address is never stored.
SCAN_RATE_LIMIT_SALT=change_me_per_deployment
#
# SECURITY-RELEVANT, leave unset unless you know the answer (R0.1.18, finding
# C9). Names the ONE header your reverse proxy OVERWRITES with the real client
# address on every inbound request. Only then is the per-IP limit per-IP: a
# header the caller can set turns the limit into a suggestion, because rotating
# it buys a fresh bucket every time.
#
# It must be OVERWRITTEN, not appended and not merely "usually present". nginx's
# `proxy_add_x_forwarded_for` APPENDS, so x-forwarded-for still starts with
# whatever the caller sent. Cloudflare's cf-connecting-ip and an explicit
# `proxy_set_header X-Acme-Client-IP $remote_addr` are the shape that qualifies.
#
# Known-forgeable names are REFUSED, not accepted: host, x-real-ip,
# x-forwarded-for, x-forwarded-host, forwarded and x-vercel-forwarded-for. A
# refused declaration logs "[rate-limit] SCAN_RATE_LIMIT_IP_HEADER=... REFUSED"
# and the limit falls back to the untrusted address, which is where an unset
# deployment already sits.
#
# On Vercel, x-vercel-forwarded-for is read as the client address when VERCEL is
# 1/true/yes/on (judged by VALUE — VERCEL=0 means NOT Vercel, and an unrecognised
# value is treated as not-Vercel and warned about). It is untrusted-pending-proof
# (RESTORE-TRUST-R0.1.20), not vouched for, which is why it answers to
# SCAN_RATE_LIMIT_ATTESTED_CEILING below.
# SCAN_RATE_LIMIT_IP_HEADER=cf-connecting-ip
#
# The deployment-wide ceiling for callers this deployment CANNOT tell apart
# (R0.1.22). With no verifiable address source — no SCAN_RATE_LIMIT_IP_HEADER
# declared above and not on Vercel — the per-address limit is bypassable by
# rotating a header, and a warning is not a limit: 100 requests with a rotating
# x-real-ip were allowed 100 times under SCAN_RATE_LIMIT=5. So a SECOND bucket,
# keyed by a constant that no request header can move, caps the whole deployment
# per window. Rotating a header now buys at most this many scans, never an
# unbounded number.
#
# Unset, it derives as 5x SCAN_RATE_LIMIT (UNVERIFIED_CEILING_MULTIPLIER in
# src/lib/rateLimit.js) — 25 per hour with the values above. Callers whose
# address came from a declared proxy header or from the platform header on Vercel
# answer to SCAN_RATE_LIMIT_ATTESTED_CEILING below instead, so on a correctly
# declared deployment this knob does nothing.
#
# Raising it buys throughput for honest anonymous clients and exactly the same
# throughput for one rotating attacker; that is the entire trade. A non-numeric
# or <= 0 value is IGNORED and the derived default applies: 0 does not mean "off"
# — a ceiling of 0 would refuse every anonymous scan, so it is treated as unset.
# There is no off switch by design; declare a real client-address header. When the
# ceiling is exhausted anonymous scans are refused until the window rolls, and
# the log says so once per process ("deployment ceiling ... is EXHAUSTED") on a
# latch of its own, because that is an outage rather than a configuration.
# SCAN_RATE_LIMIT_UNVERIFIED_CEILING=25
#
# The deployment-wide ceiling for callers whose address something OUTSIDE the
# request asserted (R0.1.24): a SCAN_RATE_LIMIT_IP_HEADER you declared above, or
# x-vercel-forwarded-for on Vercel. Both are attestations this code cannot check
# from inside a request — Vercel is DOCUMENTED to strip an inbound copy of its
# header and nobody has forged it against the deployed origin to confirm, and a
# declared header is only unforgeable if your proxy really does OVERWRITE it. Both
# used to be exempt from any ceiling: measured, 60 requests rotating
# x-vercel-forwarded-for with VERCEL=1 were allowed 60/60, and 60 rotating a
# declared header the proxy does not overwrite were allowed 60/60, by an
# unauthenticated caller, each one spending scrape + probe + LLM budget.
#
# So they get their own bucket, no request header can move it either, and it is
# deliberately FAR above honest traffic: unset it derives as 40x SCAN_RATE_LIMIT
# (ATTESTED_CEILING_MULTIPLIER in src/lib/rateLimit.js) — 200 per hour with the
# values above. It is a catastrophe bound, not a per-IP limit: if the attestation
# holds you never meet it, and if it does not, one forger buys 200 scans per
# window instead of an unbounded number. Raise it if real traffic reaches it; the
# exhaustion log (once per process, its own latch) says which of the two happened
# and names this variable. Same rules as the knob above: a non-numeric or <= 0
# value is IGNORED and the derived default applies — 0 does not mean "off", and
# there is no off switch, because every trust basis has a ceiling by design.
# SCAN_RATE_LIMIT_ATTESTED_CEILING=200

# SERP geo targeting (Google AI Overview probing). Target market is India.
SERP_GEO=in

# SERP per-QUERY prices, USD per billed query, as JSON keyed by SERP provider
# id (R3.6.4, finding S18). Unset, the built-in table in src/lib/llmPricing.js
# prices "brightdata" and "serpapi"; set this when a vendor rate changes, so a
# renegotiated price is an env edit rather than a deploy. A provider id nothing
# can price is REFUSED before the query is sent — it throws UnpricedModelError
# and logs "[llm-price] UNPRICED SERP PROVIDER" — because a scan billed at $0
# is the same lie as unpriced inference, one vendor over. This is USD per
# query, NOT per 1M tokens: the two units have separate tables for that reason.
# SERP_QUERY_PRICES={"brightdata":0.0015,"serpapi":0.01}

# Supabase (for storing scan results)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Required in production: trusted server routes and operator APIs use it after
# migration 023 removes direct anon access. Keep it server-only (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Set to the deployed site origin in Vercel; used for customer invite/reset links.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
# Database password (Settings → Database) — required for `npm run setup:db`
SUPABASE_DB_PASSWORD=your_database_password
# Pooler host (Settings → Database → Connection string → Session pooler host)
SUPABASE_DB_HOST=aws-1-REGION.pooler.supabase.com

# Firecrawl (for high-quality website scraping during prompt generation)
FIRECRAWL_API_KEY=fc_your_firecrawl_api_key_here

# Bright Data SERP (Google AI Overview source)
BRIGHTDATA_API_KEY=your_brightdata_api_key_here

# Google Search Console (real buyer queries for onboarded clients).
# Paste the service account's JSON key, base64-encoded to keep it one line:
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))
# The service-account email must be added as a Restricted user on the
# client's Search Console property (Settings -> Users and permissions).
GSC_SERVICE_ACCOUNT_KEY=base64_or_raw_json_of_service_account_key

# GSC Customer OAuth (self-service connector). One platform OAuth app serves
# all customers. Each workspace stores its own encrypted credentials.
# Set these after creating a Google Cloud OAuth 2.0 Web application with the
# Search Console read-only scope (webmasters.readonly).
GSC_GOOGLE_CLIENT_ID=your_google_oauth_client_id
GSC_GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GSC_OAUTH_REDIRECT_URI=https://your-app.vercel.app/api/customer/gsc/callback
# 32-byte encryption key, hex-encoded (64 hex chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GSC_TOKEN_ENCRYPTION_KEY=your_64_char_hex_encryption_key

# Multi-engine probing (ChatGPT + Perplexity alongside Google AIO).
# These model IDs use the shared OpenRouter credentials above; no separate
# OpenAI or Perplexity API key is needed. Set ENGINES and NEXT_PUBLIC_ENGINES
# to aio,chatgpt,perplexity to run and advertise all three. Defaults to aio.
ENGINES=aio
# Client-readable mirror of ENGINES (R2.10.1). The landing page names the
# engines it probes; a client component cannot read a server-only var. KEEP
# THESE TWO IN STEP: `npm run check:secrets` calls engineDriftWarning() and
# FAILS the run on a mismatch, and fails it again when an advertised engine has
# no shared OpenRouter key — the page would name an engine every scan skips.
# (Until R2.10.1 that warning had no caller anywhere: this comment described it as
# live while the only thing invoking it was a unit test.) A guard test also
# fails if the marketing copy names an engine this list does not contain. The
# page under-claims rather than over-claims when unset.
NEXT_PUBLIC_ENGINES=aio

# ChatGPT and Perplexity answer engines use the shared OpenRouter key above
# with OpenRouter's web-search tool. Model IDs are selected here; changing the
# model does not require another provider API key.
OPENROUTER_OPENAI_MODEL=openai/gpt-6-luna
OPENROUTER_PERPLEXITY_MODEL=perplexity/sonar

# Agent Content OS (content pipeline). Scoring/prompt-gen stays on the free
# model above; content steps use a paid, capable model on the SAME gateway
# (LLM_BASE_URL), so this id must be valid there too.
CONTENT_MODEL=anthropic/claude-sonnet-4.5
# Hard stop per content item, in USD. A job aborts if it crosses this.
CONTENT_MAX_COST_PER_ITEM=0.15
# Daily batch: create up to n content jobs from the worst uncovered gaps of the
# most recent scan per brand (runs on the existing daily cron). 0 = off.
CONTENT_DAILY_BATCH=0

# ---------------------------------------------------------------------------
# Probe fleet (worker/) — container host credentials & configuration (R1.2.12)
#
# The probe fleet runs as an independent Node process on a container host (or
# on a developer laptop in dev mode). It requires its own direct connection to
# Supabase with a service-role key to call Postgres RPC functions (claim_probe_tasks,
# open_scan_run, heartbeat_scan_run, close_scan_run).
#
# DEV-MODE PROTECTION (R1.2.12): A laptop worker REFUSES to boot against the
# production database without explicit arming. Never point a dev worker at
# production; use a dedicated dev Supabase project (see docs/runbooks/fleet-dev.md).
# To intentionally run a worker against production, set FLEET_ALLOW_PRODUCTION_DB=true.
#
# Dedicated queue URL for the fleet. In dev, point this to your dev Supabase URL.
# SUPABASE_URL=https://your-dev-project.supabase.co
#
# Dedicated service role key for the fleet. In dev, use your dev service role key.
# SUPABASE_SERVICE_ROLE_KEY=your_dev_supabase_service_role_key
#
# Explicit arming flag required to run the fleet against the production database (R1.2.12).
# Leave unset or false for laptop development.
# FLEET_ALLOW_PRODUCTION_DB=false
#
# Explicit production Supabase URL designator checked by the fleet guard (R1.2.12, R1.2.18).
# Used by laptop workers to identify and refuse accidental connections to production.
# PRODUCTION_SUPABASE_URL=https://your-production-project.supabase.co
#
# Which consumer surfaces this container drives (comma-separated: perplexity, chatgpt).
# FLEET_ENGINES=perplexity
#
# Tasks claimed per poll. Narrowed at boot to fit within the lease (default 2).
# FLEET_BATCH_SIZE=2
#
# Claim lease duration in ms (default 300000 = 5 minutes).
# FLEET_LEASE_MS=300000
#
# Polling interval in ms when the queue is empty (default 10000 = 10 seconds).
# FLEET_IDLE_POLL_MS=10000
#
# Heartbeat interval in ms for in-flight batches (default 30000 = 30 seconds).
# FLEET_HEARTBEAT_MS=30000
#
# Worker identity written onto claims and ledger records. Defaults to
# worker-<hostname>-<pid> (R1.2.22: a container pid is a constant, so a pid-only
# default gave every pod the same lease-owner string).
# FLEET_WORKER_ID=worker-dev-1
#
# ---------------------------------------------------------------------------
# Probe fleet — the politeness budget (R1.1.5)
#
# These are read by worker/ (the container fleet), NOT by the Next app, and
# every one of them is OPTIONAL: leave it unset and the surface's own number
# from docs/contracts/politeness-budget.md section 3.2 applies. A value that IS
# set overrides every surface that container drives, and a value out of range
# REFUSES THE BOOT with a non-zero exit rather than being clamped — see
# worker/README.md for the full table.
#
# Nothing paces a probe with these yet: the adapters land in R1.3/R1.4, so the
# numbers are validated and logged at boot, not applied. The boot log says so.
#
# In-flight probes of one surface per egress IP. Range 1-2, and 2 is refused
# for a logged-out consumer UI (both surfaces the fleet drives today), because
# a logged-out session is a claim to be one person.
# FLEET_MAX_CONCURRENCY=1
#
# The random wait between two probes of the same surface, in ms. Max must be
# strictly greater than min: an equal pair is a fixed delay, which is a
# signature rather than pacing. Defaults per surface: perplexity.ai
# 20000-45000, chatgpt.com 30000-90000.
# FLEET_PROBE_DELAY_MIN_MS=20000
# FLEET_PROBE_DELAY_MAX_MS=45000
#
# Probe attempts against one surface per UTC day. Defaults perplexity.ai 400,
# chatgpt.com 200. NOT ENFORCED and cannot be by an env var alone: the cap is
# fleet-wide, and a per-container variable gives N containers N times the cap.
# The boot log prints it as unenforced for that reason.
# FLEET_DAILY_CAP=400
#
# Gap between canary probes of one surface (section 4.3: one per hour).
# FLEET_CANARY_INTERVAL_MS=3600000
#
# How long one probe may run before it is abandoned. CHOSEN, not measured -- no
# probe has ever run. It is a term in the boot check that keeps a batch inside
# its lease: FLEET_BATCH_SIZE x (delay max + this) must not exceed
# FLEET_LEASE_MS, or the batch outlives its lease and its results are refused.
# FLEET_PROBE_TIMEOUT_MS=60000

# Product scan scope: keep server and browser lists identical.
ENGINES=aio,chatgpt,gemini,perplexity
NEXT_PUBLIC_ENGINES=aio,chatgpt,gemini,perplexity
OPENROUTER_GEMINI_MODEL=google/gemini-3.8-flash
# Gemini scans use the shared LLM_API_KEY and grounded OpenRouter request,
# rather than the legacy GEMINI_API_KEY helper.

# P0 durable provider dispatch (migration 027). Service database is required.
# Positive reservation per provider attempt, including unknown billed failures.
# Estimates bound authorizations, not the provider's eventual invoice.
SCAN_PROBE_RESERVATION_USD=1
# Optional scan/day authorization ceilings; zero blocks new dispatch.
# SCAN_MAX_COST_PER_SCAN=10
# SCAN_MAX_COST_PER_DAY=50

# F01 spend guard (migration 041): default daily cap in USD for a workspace with
# no workspace_spend_limits row; unset or blank = no cap.
# SPEND_DEFAULT_DAILY_CAP_USD=
# F01 spend guard: default monthly cap in USD for a workspace with no
# workspace_spend_limits row; unset or blank = no cap.
# SPEND_DEFAULT_MONTHLY_CAP_USD=

# F01 job runner (migrations 040/043): gates /api/jobs/tick. Anything but `on`
# answers 200 {skipped:"disabled"}, so queued jobs stay queued.
# FEATURE_JOBS_TICK=off

# F21 assistant skills: gates the skill catalogue the assistant may load. Off
# leaves the assistant working with tools only; skills themselves cost nothing.
# FEATURE_ASSISTANT_SKILLS=off
# Allowlist mode: the workspaces that see the catalogue, comma-separated.
# FEATURE_ASSISTANT_SKILLS_BRANDS=
# Jobs run in parallel within one tick; capped at 8.
# JOBS_TICK_CONCURRENCY=4
# Jobs claimed per tick; capped at 50.
# JOBS_TICK_CLAIM_LIMIT=8

# F01 LLM helper (src/lib/llm): default model for llmObject/llmText when the
# caller passes none. Falls back to the utility LLM_MODEL.
# LLM_HELPER_MODEL=
# Fallback estimate in USD when the gateway reports cost but the model has no
# price-table rate; rounded up to 6dp with a 0.000001 floor.
# LLM_HELPER_UNPRICED_ESTIMATE_USD=0.05

# --- F26 product analytics (PostHog EU) ---
# Public project key (safe in the browser). Empty = nothing loads.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com
# Same project key on the server.
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_INGEST_ORIGIN=https://eu.i.posthog.com
POSTHOG_ASSETS_ORIGIN=https://eu-assets.i.posthog.com
# Kill switches (1 = off).
TELEMETRY_DISABLED=
NEXT_PUBLIC_TELEMETRY_DISABLED=
# Source maps (build only; never print token values).
POSTHOG_SOURCEMAPS=
POSTHOG_CLI_TOKEN=
POSTHOG_CLI_ENV_ID=
POSTHOG_CLI_HOST=https://eu.posthog.com
# Feature flag (off in production until owner enables).
FEATURE_PRODUCT_ANALYTICS=

# --- F07 project memory ---
# Gates /portal/context, the two /api/customer/context routes and the assistant
# tools. Memory itself spends nothing, and the memory service itself is never
# gated: research history keeps filling with the flag off.
FEATURE_PROJECT_MEMORY=
# Allowlist mode: the workspaces that may use memory, comma-separated.
FEATURE_PROJECT_MEMORY_BRANDS=
# Lets Content Studio read the project-memory digest. Off returns today's brief.
FEATURE_PROJECT_MEMORY_CONTENT=
# Allowlist mode: the workspaces whose Content Studio reads memory, comma-separated.
FEATURE_PROJECT_MEMORY_CONTENT_BRANDS=

# --- F03 cost ledger ---
# Gates the customer Usage page and GET /api/customer/usage. Reading what a
# workspace has spent costs nothing, and the ledger itself is never gated.
# FEATURE_USAGE_PAGE=off
