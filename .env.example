# Copy this file to .env.local and fill in the values

# Google Gemini (legacy; retained for deprecated helpers, not used by the
# unbranded prompt-gen / competitor-extraction path — see OPENROUTER below)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM provider (required for prompt generation + competitor extraction).
# Any OpenAI-compatible chat/completions endpoint works — set base URL,
# key, and model to match your provider. Defaults to OpenRouter if
# OPENROUTER_BASE_URL is unset.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Cron/worker shared secret. REQUIRED in production: /api/scan/worker and
# /api/content/worker resume and create jobs that spend real vendor budget, and
# with this unset in NODE_ENV=production both routes now refuse every request
# (401) instead of running unauthenticated. Locally it may be left blank.
CRON_SECRET=a_long_random_string

# Operator perimeter (src/middleware.js). A single shared token over every
# /api route EXCEPT the anonymous free-scan flow (POST /api/scan, scan status,
# scan reads, /api/industries, /api/health) and the two cron workers, which
# carry their own CRON_SECRET gate. Send it as `Authorization: Bearer <token>`,
# `x-operator-token: <token>`, or an `operator_token` cookie. Unset in
# NODE_ENV=production, every operator route is refused; unset locally, they are
# open so development is not blocked. This is a choke point, not user auth --
# real per-user auth replaces it in Phase Z.
OPERATOR_TOKEN=another_long_random_string

# Free-scan rate limit (POST /api/scan). Fixed window, DB-backed
# (supabase/migrations/009). Defaults to 5 scans per hour per client address.
SCAN_RATE_LIMIT=5
SCAN_RATE_LIMIT_WINDOW_MS=3600000
# Per-deployment salt for the hashed client key. The rate-limit table is a
# counter, not a visitor log, so the raw address is never stored.
SCAN_RATE_LIMIT_SALT=change_me_per_deployment

# SERP geo targeting (Google AI Overview probing). Target market is India.
SERP_GEO=in

# Supabase (for storing scan results)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Database password (Settings → Database) — required for `npm run setup:db`
SUPABASE_DB_PASSWORD=your_database_password
# Pooler host (Settings → Database → Connection string → Session pooler host)
SUPABASE_DB_HOST=aws-1-REGION.pooler.supabase.com

# Firecrawl (for high-quality website scraping during prompt generation)
FIRECRAWL_API_KEY=fc_your_firecrawl_api_key_here

# Bright Data SERP (Google AI Overview source)
BRIGHTDATA_API_KEY=your_brightdata_api_key_here

# Google Search Console (real buyer queries for onboarded clients).
# Paste the service account's JSON key, base64-encoded to keep it one line:
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))
# The service-account email must be added as a Restricted user on the
# client's Search Console property (Settings -> Users and permissions).
GSC_SERVICE_ACCOUNT_KEY=base64_or_raw_json_of_service_account_key

# Multi-engine probing (ChatGPT + Perplexity alongside Google AIO).
# ENGINES=aio,chatgpt,perplexity to enable all three. Defaults to aio only.
ENGINES=aio

# ChatGPT engine — uses the OpenAI Responses API with web_search tool.
# Model: gpt-4o-mini (env-overridable via OPENAI_MODEL).
OPENAI_API_KEY=sk-your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Perplexity engine — two calls per query: chat completions (sonar) +
# search API for citations. Requires a paid Perplexity API key.
PERPLEXITY_API_KEY=pplx-your_perplexity_api_key_here
# PERPLEXITY_MODEL=sonar

# Agent Content OS (content pipeline). Scoring/prompt-gen stays on the free
# model above; content steps use a paid, capable model via OpenRouter.
CONTENT_MODEL=anthropic/claude-sonnet-4.5
# Hard stop per content item, in USD. A job aborts if it crosses this.
CONTENT_MAX_COST_PER_ITEM=0.15
# Daily batch: create up to n content jobs from the worst uncovered gaps of the
# most recent scan per brand (runs on the existing daily cron). 0 = off.
CONTENT_DAILY_BATCH=0
