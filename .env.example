# Copy this file to .env.local and fill in the values

# Google Gemini (required for prompt generation + visibility scans)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (for storing scan results)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Database password (Settings → Database) — required for `npm run setup:db`
SUPABASE_DB_PASSWORD=your_database_password
# Pooler host (Settings → Database → Connection string → Session pooler host)
SUPABASE_DB_HOST=aws-1-REGION.pooler.supabase.com

# Firecrawl (for high-quality website scraping during prompt generation)
FIRECRAWL_API_KEY=fc_your_firecrawl_api_key_here

# Google AI Overview probes (required for visibility scans)
# SERP provider: brightdata | serpapi
SERP_PROVIDER=brightdata
BRIGHTDATA_API_KEY=your_brightdata_api_key_here
# Optional — auto-discovered from the account if omitted
BRIGHTDATA_SERP_ZONE=serp_api1
# Optional SerpAPI fallback
# SERPAPI_KEY=your_serpapi_key_here
SERP_GEO=us
