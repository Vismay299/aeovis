# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local env files (the .example template stays tracked)
.env
.env.*
!.env.example

# Command Code agent state
.commandcode/

# design prototype build output — regenerate with `node scripts/build-prototype.mjs`
/design-options/perceev-prototype.html
# design review screenshots (6MB+); the prototype itself is the record
/design-options/previews/
.claude/orchestration/tasks.json.lock
.claude/orchestration/*.tmp
