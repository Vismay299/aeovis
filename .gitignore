# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# The fleet is a separate npm workspace with its own dependency set, so the
# rooted pattern above does not reach it.
/worker/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local env files (the .example template stays tracked)
.env
.env.*
!.env.example

# Command Code agent state
.commandcode/

# design prototype build output — regenerate with `node scripts/build-prototype.mjs`
/design-options/perceev-prototype.html
# design review screenshots (6MB+); the prototype itself is the record
/design-options/previews/
.claude/orchestration/tasks.json.lock
.claude/orchestration/*.tmp

# Generated acceptance packets and screenshots (CI uploads these as artifacts).
/test_reports/public-browser/
/test_reports/repairs/
/test_reports/f04-browser/
/test_reports/f09-browser/
/test_reports/f07-browser/

# Playwright MCP browser session snapshots
.playwright-mcp/

# Role handoff notes from feature build sessions (features/_BUILD-PROMPT.md)
.team/
