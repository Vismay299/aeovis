{
  "name": "next-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:prompts": "node --env-file=.env.local scripts/test-dynamic-prompts.mjs",
    "test:scoring": "node --import ./src/lib/liveWriteGuardAuto.mjs --test \"src/**/*.test.mjs\"",
    "test:live": "node --import ./src/lib/liveWriteGuardAuto.mjs --env-file=.env.local --test",
    "test:calibration": "node src/lib/scoring/test_calibration.js",
    "test:gsc": "node --env-file=.env.local scripts/test-gsc.mjs",
    "setup:db": "node --env-file=.env.local scripts/setup-supabase.mjs",
    "check:secrets": "node --env-file-if-exists=.env.local scripts/check-secrets.mjs",
    "fleet:check": "npm --prefix worker run check",
    "fleet:dev": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.fleet.local worker/src/index.js",
    "test": "node --import ./src/lib/liveWriteGuardAuto.mjs --test \"src/**/*.test.mjs\"",
    "baseline:archive": "node --env-file-if-exists=.env.local scripts/archive-reference-scan.mjs",
    "check:uat": "node --env-file-if-exists=.env.local scripts/check-customer-uat.mjs",
    "qa:public-browser": "node scripts/qa/check-public-browser.mjs",
    "qa:repair": "node scripts/qa/run-repair.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "^2.108.2",
    "@vercel/functions": "^3.9.7",
    "framer-motion": "^12.42.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.22.0",
    "next": "15.5.27",
    "react": "^18",
    "react-dom": "^18",
    "sonner": "^2.0.7",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "eslint": "^8",
    "eslint-config-next": "15.5.27",
    "pg": "^8.22.0",
    "playwright": "1.64.1",
    "postcss": "8.5.29",
    "tailwindcss": "^3.4.1",
    "typescript": "6.0.3"
  },
  "overrides": {
    "postcss": "8.5.29",
    "postcss-selector-parser": "7.1.6",
    "source-map-js": "1.2.2",
    "nanoid": "^3.3.20"
  },
  "engines": {
    "node": ">=22.22.0 <23"
  }
}
