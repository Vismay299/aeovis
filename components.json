{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-nova",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/app/globals.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "aliases": {
    "components": "@/components",
    "utils": "@/shared/utils",
    "ui": "@/components/ui",
    "lib": "@/shared",
    "hooks": "@/components/app/hooks"
  },
  "menuColor": "default",
  "menuAccent": "subtle",
  "registries": {
    "@bklit": "https://ui.bklit.com/r/{name}.json",
    "@kokonutui": "https://kokonutui.com/r/{name}.json",
    "@motion-primitives": "https://motion-primitives.com/c/{name}.json",
    "@watermelon": "https://ui.watermelon.sh/r/{name}.json"
  }
}
